# ============================================================
# 大数据集与中间产物
# 本仓库只放「结论 + 可复算的脚本」，不放原始数据。
# 数据的获取方式见 README「数据来源与复现」一节。
# ============================================================

# 原始数据集（170,653 行 / 约 28 MB，公开数据集，按许可不在本仓库再分发）
data/
archive/
archive.zip
trans/
release/data/

# ============================================================
# Headless 浏览器运行期产物
# 体积巨大（近 300 MB）且含本机浏览器用户配置，绝不入库。
# ⚠️ 注意前缀斜杠：/verify/ 只匹配项目根目录下的 verify/；
#    release/verify/（8 层自动化测试脚本）是源码，必须保留。
# ============================================================
/verify/

# 开发期过程归档（中间态，非交付物）
_retired_work/
_retired_work2/

# ============================================================
# 运行环境
# ============================================================
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# WorkBuddy 项目数据（非源码）
.workbuddy/

# 临时文件与日志
*.log
tmp/
